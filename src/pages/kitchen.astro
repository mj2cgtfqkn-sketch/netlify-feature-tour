---
import Layout from '../components/layout.astro';
import KitchenOrders from '../components/kitchen-orders.jsx';
---

<style>
  /* Kitchen Display Styles */
  .kitchen-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    color: var(--text-muted);
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--neutral-light-300);
    border-top-color: var(--teal-500);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Container */
  .kitchen-container {
    font-family: var(--font-secondary);
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Status Bar */
  .kitchen-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    background: var(--neutral-dark-800);
    color: var(--neutral-light-000);
    padding: 0.75rem 1.25rem;
    border-radius: var(--border-radius-3);
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
  }

  .sync-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sync-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .sync-ok {
    background: var(--green-400);
    box-shadow: 0 0 6px var(--green-400);
  }

  .sync-error {
    background: var(--red-500);
    box-shadow: 0 0 6px var(--red-500);
  }

  .status-bar-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .auto-refresh-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    font-size: 0.8rem;
  }

  .auto-refresh-toggle input {
    cursor: pointer;
  }

  .refresh-btn {
    background: var(--teal-500);
    color: white;
    border: none;
    padding: 0.4rem 1rem;
    border-radius: var(--border-radius-2);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.8rem;
    transition: background 0.2s;
  }

  .refresh-btn:hover {
    background: var(--teal-600);
  }

  /* Error */
  .kitchen-error {
    background: var(--red-000);
    color: var(--red-700);
    border: 1px solid var(--red-300);
    border-radius: var(--border-radius-2);
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    text-align: right;
  }

  /* Stats */
  .kitchen-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .stat {
    text-align: center;
    padding: 1rem;
    border-radius: var(--border-radius-3);
    background: var(--white);
    border: 1px solid var(--lightBorder);
    box-shadow: 0 1px 3px rgb(0 0 0 / 8%);
  }

  .stat-count {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    font-family: var(--font-primary);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .stat-new .stat-count { color: var(--blue-600); }
  .stat-progress .stat-count { color: var(--gold-500); }
  .stat-done .stat-count { color: var(--green-500); }

  /* Filter Tabs */
  .kitchen-filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .filter-tab {
    background: var(--white);
    border: 1px solid var(--lightBorder);
    padding: 0.4rem 1rem;
    border-radius: var(--border-radius-pill);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s;
    color: var(--text);
  }

  .filter-tab:hover {
    border-color: var(--teal-400);
  }

  .filter-active {
    background: var(--teal-500);
    color: white;
    border-color: var(--teal-500);
  }

  /* Orders Grid */
  .orders-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 650px) {
    .orders-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .orders-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Order Card */
  .order-card {
    background: var(--white);
    border: 2px solid var(--lightBorder);
    border-radius: var(--border-radius-3);
    padding: 1rem 1.25rem;
    box-shadow: 0 2px 6px rgb(0 0 0 / 8%);
    transition: border-color 0.2s, box-shadow 0.2s;
    position: relative;
  }

  .order-card:hover {
    box-shadow: 0 4px 12px rgb(0 0 0 / 12%);
  }

  .order-new { border-right: 5px solid var(--blue-500); }
  .order-in_progress { border-right: 5px solid var(--gold-400); }
  .order-completed { border-right: 5px solid var(--green-400); opacity: 0.75; }

  .order-urgent-flash {
    animation: urgentPulse 2s ease-in-out infinite;
  }

  @keyframes urgentPulse {
    0%, 100% { box-shadow: 0 2px 6px rgb(0 0 0 / 8%); }
    50% { box-shadow: 0 0 16px var(--red-300); border-color: var(--red-400); }
  }

  .order-header {
    margin-bottom: 0.75rem;
  }

  .order-id-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }

  .order-id {
    font-weight: 700;
    font-family: var(--font-primary);
    font-size: 1rem;
  }

  .priority-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: var(--border-radius-pill);
    text-transform: uppercase;
  }

  .priority-urgent {
    background: var(--red-100);
    color: var(--red-700);
  }

  .priority-high {
    background: var(--gold-100);
    color: var(--gold-700);
  }

  .priority-normal {
    background: var(--neutral-light-200);
    color: var(--neutral-light-700);
  }

  .order-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .order-table {
    font-weight: 600;
    color: var(--text);
  }

  .elapsed-warning {
    color: var(--red-600);
    font-weight: 700;
  }

  /* Order Items */
  .order-items {
    border-top: 1px solid var(--neutral-light-200);
    padding-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .order-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.25rem 0;
    font-size: 0.9rem;
  }

  .item-qty {
    font-weight: 700;
    color: var(--teal-600);
    min-width: 2rem;
  }

  .item-name {
    flex: 1;
  }

  .item-notes {
    font-size: 0.75rem;
    color: var(--gold-600);
    font-style: italic;
    background: var(--gold-000);
    padding: 0.1rem 0.4rem;
    border-radius: var(--border-radius-2);
  }

  /* Order Footer */
  .order-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--neutral-light-200);
    padding-top: 0.75rem;
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--border-radius-2);
  }

  .status-new {
    background: var(--blue-000);
    color: var(--blue-700);
  }

  .status-in_progress {
    background: var(--gold-000);
    color: var(--gold-700);
  }

  .status-completed {
    background: var(--green-000);
    color: var(--green-700);
  }

  .action-btn {
    border: none;
    padding: 0.4rem 0.9rem;
    border-radius: var(--border-radius-2);
    cursor: pointer;
    font-weight: 700;
    font-size: 0.8rem;
    transition: background 0.2s, transform 0.1s;
    color: white;
  }

  .action-btn:hover {
    transform: scale(1.03);
  }

  .action-btn:active {
    transform: scale(0.97);
  }

  .action-in_progress {
    background: var(--gold-400);
  }

  .action-in_progress:hover {
    background: var(--gold-500);
  }

  .action-completed {
    background: var(--green-500);
  }

  .action-completed:hover {
    background: var(--green-600);
  }

  /* Source Badge */
  .order-source {
    position: absolute;
    top: 0.5rem;
    left: 0.75rem;
  }

  .source-badge {
    font-size: 0.6rem;
    font-weight: 700;
    background: var(--purple-100);
    color: var(--purple-700);
    padding: 0.1rem 0.4rem;
    border-radius: var(--border-radius-2);
  }

  /* No Orders */
  .no-orders {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: var(--text-muted);
    font-size: 1.1rem;
  }
</style>

<Layout
  title="מטבח - הזמנות לביצוע"
  description="מערכת ניהול הזמנות מטבח מסונכרנת עם iPlan"
>
  <main>
    <KitchenOrders client:load />
  </main>
</Layout>
